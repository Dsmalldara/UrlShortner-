# Copy this file to .env and adjust it for your local PostgreSQL installation.
# Command-line environment values override values in .env.
PGHOST=localhost
PGPORT=5432
PGDATABASE=url_shortener

# If omitted, the app uses your shell's USER as the PostgreSQL role.
# Uncomment and replace this if your PostgreSQL role is different.
# PGUSER=your_postgres_role

# Leave unset if your local PostgreSQL authentication does not require a password.
# PGPASSWORD=your_postgres_password

# Maximum application connections; matches the code's default.
PGPOOL_MAX=10

# Disposable database used only by the load-test tools.
# Its name must end in _loadtest. --reset deletes its URL data.
LOADTEST_DATABASE=url_shortener_loadtest
